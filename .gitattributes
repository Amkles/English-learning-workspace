# 一律 LF，避免 Windows 检出时把换行改成 CRLF 导致 CI 的重建比对误报
* text=auto eol=lf

# 二进制
*.png binary
*.jpg binary
*.ico binary

# 构建产物：由 src/ 与 data/ 生成，diff 里看不出有意义的变化
english-learning/cet6-daily/index.html linguist-generated=true

# 题库：大段 JSON，避免 diff 噪音
english-learning/cet6-daily/data/*.json -diff linguist-generated=true

# 学术工作台是手写单文件，算源码，不做生成标记
academic-workspace/index.html linguist-generated=false
